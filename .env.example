# Copy this file to `.env.local` and fill in your key. Never commit `.env.local`.

# Groq — free tier key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Models (optional — these are the defaults). Both must support structured
# output (json_schema). Work is split across two models because Groq rate
# limits are per model (free tier: ~8k tokens/minute on gpt-oss-120b).
#   GROQ_MODEL       scoring pass + writing tools (quality matters most)
#   GROQ_FAST_MODEL  rewrites/interview-prep pass + chat
# If a model is retired on Groq, the app falls back automatically.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# --- Durable rate limiting (optional but STRONGLY recommended in production) ---
# The AI routes are public and each call bills your Groq key. Without a shared
# store the limiter is in-memory only (per-instance, bypassable by IP rotation).
# Provision an Upstash Redis database (Vercel Marketplace → Upstash, or
# upstash.com) and set these; the app upgrades to a durable cross-instance
# limiter automatically. Vercel KV-compatible names (KV_REST_API_URL /
# KV_REST_API_TOKEN) are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site URL for OG/canonical tags (falls back to the Vercel production
# domain if unset). e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
